{
  "info": {
    "name": "Reserva Hotel - CRUD Habitacion",
    "description": "Prueba el CRUD de Habitacion, sus validaciones, cambio de tipo, numero unico y bloqueo de eliminacion de tipos con habitaciones. Ejecutar completa en orden. Los nombres e ids se generan automaticamente y se eliminan solo los datos propios de la prueba. Las operaciones de modificacion producen registros de AuditoriaAspect; las consultas de tipos producen mediciones de TimeAspect en los logs del backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "tipoA",
      "value": "",
      "type": "string"
    },
    {
      "key": "tipoB",
      "value": "",
      "type": "string"
    },
    {
      "key": "habitacionA",
      "value": "",
      "type": "string"
    },
    {
      "key": "habitacionB",
      "value": "",
      "type": "string"
    },
    {
      "key": "numeroA",
      "value": "",
      "type": "string"
    },
    {
      "key": "numeroB",
      "value": "",
      "type": "string"
    },
    {
      "key": "numeroDuplicado",
      "value": "",
      "type": "string"
    },
    {
      "key": "nombreTipoA",
      "value": "",
      "type": "string"
    },
    {
      "key": "nombreTipoB",
      "value": "",
      "type": "string"
    },
    {
      "key": "creadoOriginal",
      "value": "",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Formato ActionResponse', function () {",
          "    const body = pm.response.json();",
          "    pm.expect(body).to.have.property('message').that.is.a('string');",
          "    pm.expect(body).to.have.property('result');",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Preparar y consultar",
      "item": [
        {
          "name": "01 - Crear tipo A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/tipo-habitacion",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"{{nombreTipoA}}\",\n  \"descripcion\": \"Tipo de habitacion creado para pruebas de Postman\",\n  \"capacidad\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const sufijo = Date.now().toString(36) + '-' + Math.floor(Math.random() * 65536).toString(16);",
                  "pm.collectionVariables.set('nombreTipoA', 'Tipo A ' + sufijo);",
                  "pm.collectionVariables.set('nombreTipoB', 'Tipo B ' + sufijo);",
                  "pm.collectionVariables.set('numeroA', 'A-' + sufijo);",
                  "pm.collectionVariables.set('numeroDuplicado', ('A-' + sufijo).toLowerCase());",
                  "pm.collectionVariables.set('numeroB', 'B-' + sufijo);",
                  "['tipoA', 'tipoB', 'habitacionA', 'habitacionB', 'creadoOriginal'].forEach(key => pm.collectionVariables.unset(key));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 201', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) pm.collectionVariables.set('tipoA', pm.response.json().result.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Crear tipo B",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/tipo-habitacion",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"{{nombreTipoB}}\",\n  \"descripcion\": \"Tipo de habitacion creado para pruebas de Postman\",\n  \"capacidad\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 201', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) pm.collectionVariables.set('tipoB', pm.response.json().result.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "03 - Crear habitacion en planta baja",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/habitacion",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numero\": \"{{numeroA}}\",\n  \"piso\": 0,\n  \"precioNoche\": 45.5,\n  \"estado\": \"DISPONIBLE\",\n  \"tipoHabitacionId\": {{tipoA}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 201', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "    const h = pm.response.json().result;",
                  "    pm.collectionVariables.set('habitacionA', h.id);",
                  "    pm.collectionVariables.set('creadoOriginal', h.creado);",
                  "}",
                  "pm.test('Guarda piso cero precio tipo y auditoria', function () {",
                  "    const h = pm.response.json().result;",
                  "    pm.expect(h.id).to.be.a('number').above(0);",
                  "    pm.expect(h.piso).to.eql(0);",
                  "    pm.expect(h.precioNoche).to.eql(45.5);",
                  "    pm.expect(h.tipoHabitacionId).to.eql(Number(pm.collectionVariables.get('tipoA')));",
                  "    pm.expect(h.tipoHabitacionNombre).to.eql(pm.collectionVariables.get('nombreTipoA'));",
                  "    pm.expect(h.estado).to.eql('DISPONIBLE');",
                  "    pm.expect(h.creado).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "04 - Listar habitaciones",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/habitacion"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('El listado incluye la habitacion con su tipo', function () {",
                  "    const h = pm.response.json().result.find(h => h.id === Number(pm.collectionVariables.get('habitacionA')));",
                  "    pm.expect(h).to.be.an('object');",
                  "    pm.expect(h.tipoHabitacionNombre).to.eql(pm.collectionVariables.get('nombreTipoA'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "05 - Buscar habitacion por id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/habitacion/{{habitacionA}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Consulta la habitacion solicitada', function () { pm.expect(pm.response.json().result.numero).to.eql(pm.collectionVariables.get('numeroA')); });"
                ]
              }
            }
          ]
        }
      ]
    },
