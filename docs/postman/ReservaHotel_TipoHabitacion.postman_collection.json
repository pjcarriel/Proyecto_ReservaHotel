{
  "info": {
    "name": "Reserva Hotel - CRUD TipoHabitacion",
    "description": "Prueba los cinco endpoints de TipoHabitacion y sus validaciones. Ejecutar la coleccion completa en orden: crea nombres unicos, guarda los ids automaticamente y elimina solamente sus dos registros de prueba. baseUrl contiene el servidor sin /api/v1. Requiere el backend y MySQL en ejecucion. precioNoche pertenece al dominio Habitacion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "tipoHabitacionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "segundoTipoId",
      "value": "",
      "type": "string"
    },
    {
      "key": "nombrePrueba",
      "value": "",
      "type": "string"
    },
    {
      "key": "nombreDuplicado",
      "value": "",
      "type": "string"
    },
    {
      "key": "nombreSegundo",
      "value": "",
      "type": "string"
    },
    {
      "key": "nombreActualizado",
      "value": "",
      "type": "string"
    },
    {
      "key": "creadoOriginal",
      "value": "",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Respuesta con formato ActionResponse', function () {",
          "    const body = pm.response.json();",
          "    pm.expect(body).to.have.property('message').that.is.a('string');",
          "    pm.expect(body).to.have.property('result');",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Crear listar y consultar",
      "item": [
        {
          "name": "01 - Crear tipo de habitacion",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/tipo-habitacion",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"{{nombrePrueba}}\",\n  \"descripcion\": \"Habitacion confortable para los huespedes\",\n  \"capacidad\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const sufijo = Date.now() + '-' + Math.floor(Math.random() * 100000);",
                  "const nombre = 'Doble prueba ' + sufijo;",
                  "pm.collectionVariables.set('nombrePrueba', nombre);",
                  "pm.collectionVariables.set('nombreDuplicado', nombre.toUpperCase());",
                  "pm.collectionVariables.set('nombreSegundo', 'Suite prueba ' + sufijo);",
                  "pm.collectionVariables.set('nombreActualizado', 'Doble actualizado ' + sufijo);",
                  "pm.collectionVariables.unset('tipoHabitacionId');",
                  "pm.collectionVariables.unset('segundoTipoId');",
                  "pm.collectionVariables.unset('creadoOriginal');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 201', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "    const tipo = pm.response.json().result;",
                  "    pm.collectionVariables.set('tipoHabitacionId', tipo.id);",
                  "    pm.collectionVariables.set('creadoOriginal', tipo.creado);",
                  "}",
                  "pm.test('Guarda id, capacidad y auditoria', function () {",
                  "    const tipo = pm.response.json().result;",
                  "    pm.expect(tipo.id).to.be.a('number').above(0);",
                  "    pm.expect(tipo.capacidad).to.eql(2);",
                  "    pm.expect(tipo.creado).to.be.a('string');",
                  "    pm.expect(tipo.modificado).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Crear segundo tipo para comprobar duplicados",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/tipo-habitacion",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"{{nombreSegundo}}\",\n  \"descripcion\": \"Habitacion confortable para los huespedes\",\n  \"capacidad\": 4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 201', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) pm.collectionVariables.set('segundoTipoId', pm.response.json().result.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "03 - Listar tipos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/tipo-habitacion"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('El listado contiene el tipo creado', function () {",
                  "    const tipos = pm.response.json().result;",
                  "    pm.expect(tipos).to.be.an('array');",
                  "    pm.expect(tipos.some(tipo => tipo.id === Number(pm.collectionVariables.get('tipoHabitacionId')))).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "04 - Buscar por id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/tipo-habitacion/{{tipoHabitacionId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Devuelve el tipo solicitado', function () {",
                  "    const tipo = pm.response.json().result;",
                  "    pm.expect(tipo.id).to.eql(Number(pm.collectionVariables.get('tipoHabitacionId')));",
                  "    pm.expect(tipo.nombre).to.eql(pm.collectionVariables.get('nombrePrueba'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
